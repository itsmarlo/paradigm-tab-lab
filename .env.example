# Copy this file to .env and fill in your own SAP AI Core service-key values.
# The saved comparison notebooks run without SAP credentials.
SAP_AI_CORE_API_URL=
SAP_AI_CORE_AUTH_URL=
SAP_AI_CORE_CLIENT_ID=
SAP_AI_CORE_CLIENT_SECRET=
SAP_AI_CORE_RESOURCE_GROUP=
SAP_RPT_DEPLOYMENT_ID=
SAP_RPT_MODEL_NAME=sap-rpt-1.6-large
RPT_DRY_RUN=true
